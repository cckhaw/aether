# Neon Postgres (Vercel: Storage -> Neon -> Connect Project sets this)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth base URL (Neon Console -> project -> Auth -> Configuration). Same value, two names:
# the browser bundle needs the VITE_ one, the API routes read NEON_AUTH_BASE_URL.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth
